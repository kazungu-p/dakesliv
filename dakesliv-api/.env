PORT=3001
DATABASE_URL=postgres://postgres:plusUltra%401999@localhost:5432/dakesliv

# Odoo integration (see InvoicingService.transmitToOdoo)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
# The Odoo record id of your 16% VAT sale tax — find it in Odoo under
# Accounting > Configuration > Taxes (enable Developer Mode to see the id
# in the URL when you open that tax record)
ODOO_VAT_TAX_ID=

# IntaSend (M-Pesa STK Push + card) — get these from your IntaSend dashboard.
# Sandbox keys work for testing; switch to live keys (and set NODE_ENV=production)
# when you're ready to take real payments.
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
# Set this to the same value you configure as the webhook "challenge" in
# the IntaSend dashboard, then wire the check into PaymentsController — see
# the TODO on the webhook endpoint.
INTASEND_WEBHOOK_CHALLENGE=

# ── Customer sign-in ──────────────────────────────────────────────────────
# Google sign-in. Create OAuth client IDs in Google Cloud Console →
# APIs & Services → Credentials (consent screen must be configured first).
# You need one client ID per platform you sign in from (Web, Android, iOS) —
# list them ALL here, comma-separated. A token minted for any other client
# ID is rejected.
GOOGLE_CLIENT_IDS=278621013881-rlkvu9i2jqaghgocjq0020s0ovl968gg.apps.googleusercontent.com

# Email sign-in codes are sent over SMTP, so any provider works (Resend,
# Brevo, SendGrid, Postmark, Amazon SES, Zoho, Google Workspace...). The
# codes can be delivered TO any mailbox — iCloud, Gmail, Outlook, etc.
# Use a provider/domain you control and set up SPF + DKIM on it, otherwise
# iCloud and Gmail will send the codes to spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. DAKESLIV <no-reply@yourdomain.com> — must be an address your SMTP
# provider has verified.
MAIL_FROM=

# Signs customer session tokens issued after sign-in — use a long
# random string, not this placeholder
JWT_SECRET=Tscv8XxvvJChmJmLb8UNXMtYXglIhZJh

# Creates the first admin panel (OWNER role) account when you run
# `npm run seed` — only needed once. Leave blank to skip.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
